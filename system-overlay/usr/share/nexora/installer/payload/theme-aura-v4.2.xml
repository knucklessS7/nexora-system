<?xml version="1.0" encoding="UTF-8"?>
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>

  <!-- =========================================================
       BATOCERA DYNAMIC V4.2
       Refino visual: sistema + detailed + menu
       ========================================================= -->

  <!-- ===================== TELA DE SISTEMAS ===================== -->
  <view name="system">

    <image name="background" extra="static">
      <path>./art/white.png</path>
      <color>07101CFF</color>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <zIndex>1</zIndex>
    </image>

    <text name="manufacturerName" extra="true">
      <text>${system.sortedBy}</text>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.044</fontSize>
      <pos>0.035 0.038</pos>
      <size>0.93 0.065</size>
      <color>F4F8FFFF</color>
      <zIndex>30</zIndex>
    </text>

    <text name="fullName" extra="true">
      <text>${system.fullName}</text>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.0165</fontSize>
      <pos>0.037 0.102</pos>
      <size>0.50 0.028</size>
      <color>7890A8FF</color>
      <zIndex>30</zIndex>
      <visible>false</visible>
    </text>

    <text name="releaseYear" extra="true">
      <text>${system.releaseYearOrNull}</text>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.018</fontSize>
      <pos>0.037 0.130</pos>
      <size>0.40 0.028</size>
      <color>60758BFF</color>
      <zIndex>30</zIndex>
      <visible>false</visible>
    </text>

    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0 0.405</pos>
      <size>1 0.235</size>
      <color>0A1625EE</color>
      <colorEnd>111F35EE</colorEnd>
      <gradientType>horizontal</gradientType>
      <logoSize>0.16 0.10</logoSize>
      <logoScale>1.28</logoScale>
      <logoAlignment>center</logoAlignment>
      <maxLogoCount>5</maxLogoCount>
      <minLogoOpacity>0.55</minLogoOpacity>
      <transitionSpeed>340</transitionSpeed>
      <systemInfoDelay>450</systemInfoDelay>
      <systemInfoCountOnly>false</systemInfoCountOnly>
      <zIndex>20</zIndex>
    </carousel>

    <image name="logo">
      <path>./art/logos/${system.theme}-w.png</path>
      <path>./art/logos/${system.theme}-w.svg</path>
      <path>./art/logos/${system.theme}.png</path>
      <path>./art/logos/${system.theme}.svg</path>
      <linearSmooth>true</linearSmooth>
    </image>

    <image name="logo" if="{system.collection}">
      <path>./art/logos/collections/${system.theme}-w.png</path>
      <path>./art/logos/collections/${system.theme}-w.svg</path>
      <path>./art/logos/collections/${system.theme}.png</path>
      <path>./art/logos/collections/${system.theme}.svg</path>
    </image>

    <image name="logo" region="br">
      <path>./art/logos/br/${system.theme}-w.png</path>
      <path>./art/logos/br/${system.theme}-w.svg</path>
      <path>./art/logos/br/${system.theme}.png</path>
      <path>./art/logos/br/${system.theme}.svg</path>
    </image>

    <image name="carouselTop" extra="true">
      <path>./art/white.png</path>
      <color>35C2FFFF</color>
      <pos>0 0.403</pos>
      <origin>0 0</origin>
      <size>1 0.002</size>
      <zIndex>25</zIndex>
    </image>

    <image name="carouselBottom" extra="true">
      <path>./art/white.png</path>
      <color>35C2FFFF</color>
      <pos>0 0.642</pos>
      <origin>0 0</origin>
      <size>1 0.002</size>
      <zIndex>25</zIndex>
    </image>

    <text name="systemInfo">
      <pos>0.15 0.675</pos>
      <size>0.70 0.105</size>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.019</fontSize>
      <alignment>center</alignment>
      <verticalAlignment>top</verticalAlignment>
      <color>DDEBFAFF</color>
      <backgroundColor>00000000</backgroundColor>
      <zIndex>30</zIndex>
    </text>

    <image name="bottomBar" extra="static">
      <path>./art/white.png</path>
      <color>07101CF2</color>
      <pos>0 0.944</pos>
      <origin>0 0</origin>
      <size>1 0.056</size>
      <zIndex>40</zIndex>
    </image>

    <helpsystem name="help">
      <pos>0.018 0.952</pos>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.024</fontSize>
      <textColor>DDEBFAFF</textColor>
      <iconColor>35C2FFFF</iconColor>
      <zIndex>50</zIndex>
    </helpsystem>
  </view>


  <!-- ============== ELEMENTOS COMUNS DAS LISTAS ============== -->
  <view name="basic, detailed">

    <image name="background">
      <path>./art/white.png</path>
      <color>07101CFF</color>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <zIndex>1</zIndex>
    </image>

    <image name="topPanel" extra="true">
      <path>./art/white.png</path>
      <color>091523F7</color>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 0.135</size>
      <zIndex>10</zIndex>
    </image>

    <image name="topLine" extra="true">
      <path>./art/white.png</path>
      <color>35C2FFFF</color>
      <pos>0 0.133</pos>
      <origin>0 0</origin>
      <size>1 0.002</size>
      <zIndex>20</zIndex>
    </image>

    <image name="logo">
      <path>./art/logos/${system.theme}-w.png</path>
      <path>./art/logos/${system.theme}-w.svg</path>
      <path>./art/logos/${system.theme}.png</path>
      <path>./art/logos/${system.theme}.svg</path>
      <pos>0.5 0.072</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.22 0.072</maxSize>
      <linearSmooth>true</linearSmooth>
      <zIndex>30</zIndex>
    </image>

    <image name="logo" if="{system.collection}">
      <path>./art/logos/collections/${system.theme}-w.png</path>
      <path>./art/logos/collections/${system.theme}-w.svg</path>
      <path>./art/logos/collections/${system.theme}.png</path>
      <path>./art/logos/collections/${system.theme}.svg</path>
    </image>

    <text name="logoText">
      <pos>0.04 0.035</pos>
      <size>0.92 0.075</size>
      <alignment>center</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>./art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.044</fontSize>
      <color>F4F8FFFF</color>
      <zIndex>25</zIndex>
    </text>

    <text name="folderpath">
      <pos>0.05 0.115</pos>
      <size>0.90 0.020</size>
      <alignment>center</alignment>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.014</fontSize>
      <color>7890A8FF</color>
      <zIndex>30</zIndex>
    </text>

    <image name="bottomBar" extra="true">
      <path>./art/white.png</path>
      <color>07101CF5</color>
      <pos>0 0.943</pos>
      <origin>0 0</origin>
      <size>1 0.057</size>
      <zIndex>50</zIndex>
    </image>

    <helpsystem name="help">
      <pos>0.018 0.953</pos>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.019</fontSize>
      <textColor>DDEBFAFF</textColor>
      <iconColor>35C2FFFF</iconColor>
      <zIndex>60</zIndex>
    </helpsystem>
  </view>


  <!-- ====================== LISTA BASIC ====================== -->
  <view name="basic">
    <textlist name="gamelist">
      <pos>0.085 0.185</pos>
      <size>0.830 0.710</size>
      <lines>14</lines>
      <alignment>left</alignment>
      <horizontalMargin>0.018</horizontalMargin>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.032</fontSize>
      <primaryColor>A8B6C8FF</primaryColor>
      <secondaryColor>7890A8FF</secondaryColor>
      <selectedColor>FFFFFFFF</selectedColor>
      <selectorColor>35C2FF3D</selectorColor>
      <extraTextColor>60758BFF</extraTextColor>
      <extraTextSelectedColor>C6EFFFFF</extraTextSelectedColor>
      <scrollbarColor>35C2FF35</scrollbarColor>
      <scrollbarSize>0.004</scrollbarSize>
      <scrollbarAlignment>outerright</scrollbarAlignment>
      <forceUppercase>false</forceUppercase>
    </textlist>
  </view>


  <!-- ===================== LISTA DETAILED ===================== -->
  <view name="detailed">

    <!-- Painel esquerdo -->
    <image name="mediaPanel" extra="true">
      <path>./art/white.png</path>
      <color>0B1828E8</color>
      <pos>0.045 0.170</pos>
      <origin>0 0</origin>
      <size>0.445 0.680</size>
      <zIndex>8</zIndex>
    </image>

    <!-- Divisor central -->
    <image name="detailDivider" extra="true">
      <path>./art/white.png</path>
      <color>35C2FF65</color>
      <pos>0.505 0.170</pos>
      <origin>0 0</origin>
      <size>0.002 0.680</size>
      <zIndex>15</zIndex>
    </image>

    <!-- Lista à direita -->
    <textlist name="gamelist">
      <pos>0.535 0.185</pos>
      <size>0.420 0.655</size>
      <lines>12</lines>
      <alignment>left</alignment>
      <horizontalMargin>0.012</horizontalMargin>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.024</fontSize>
      <primaryColor>A8B6C8FF</primaryColor>
      <secondaryColor>7890A8FF</secondaryColor>
      <selectedColor>FFFFFFFF</selectedColor>
      <selectorColor>35C2FF55</selectorColor>
      <extraTextColor>60758BFF</extraTextColor>
      <extraTextSelectedColor>C6EFFFFF</extraTextSelectedColor>
      <scrollbarColor>35C2FF35</scrollbarColor>
      <scrollbarSize>0.004</scrollbarSize>
      <scrollbarAlignment>outerright</scrollbarAlignment>
      <forceUppercase>false</forceUppercase>
    </textlist>

    <!-- Título do jogo selecionado -->
    <text name="md_name">
      <pos>0.060 0.185</pos>
      <size>0.405 0.050</size>
      <fontPath>./art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.028</fontSize>
      <color>F4F8FFFF</color>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <singleLineScroll>true</singleLineScroll>
      <zIndex>30</zIndex>
    </text>

    <!-- Vídeo / screenshot -->
    <video name="md_video">
      <pos>0.267 0.385</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.350 0.285</maxSize>
      <delay>1.0</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <defaultSnapshot>./art/grid/defgame.png</defaultSnapshot>
      <loops>0</loops>
      <zIndex>25</zIndex>
    </video>

    <!-- Metadados -->
    <text name="md_developer">
      <pos>0.060 0.548</pos>
      <size>0.270 0.030</size>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.017</fontSize>
      <color>77D9FFFF</color>
      <singleLineScroll>true</singleLineScroll>
      <zIndex>30</zIndex>
    </text>

    <text name="md_genre">
      <pos>0.330 0.548</pos>
      <size>0.135 0.030</size>
      <alignment>right</alignment>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.017</fontSize>
      <color>7890A8FF</color>
      <singleLineScroll>true</singleLineScroll>
      <zIndex>30</zIndex>
    </text>

    <text name="md_lbl_releasedate">
      <text>Data</text>
      <pos>0.060 0.582</pos>
      <size>0.055 0.026</size>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.015</fontSize>
      <color>60758BFF</color>
    </text>

    <datetime name="md_releasedate">
      <pos>0.115 0.582</pos>
      <size>0.125 0.026</size>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.015</fontSize>
      <color>A8B6C8FF</color>
      <format>%d/%m/%Y</format>
    </datetime>

    <text name="md_lbl_players">
      <text>Jogadores</text>
      <pos>0.270 0.582</pos>
      <size>0.090 0.026</size>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.015</fontSize>
      <color>60758BFF</color>
    </text>

    <text name="md_players">
      <pos>0.365 0.582</pos>
      <size>0.100 0.026</size>
      <alignment>right</alignment>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.015</fontSize>
      <color>A8B6C8FF</color>
    </text>

    <text name="md_description">
      <pos>0.060 0.630</pos>
      <size>0.405 0.145</size>
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.018</fontSize>
      <color>A8B6C8FF</color>
      <lineSpacing>1.14</lineSpacing>
      <zIndex>30</zIndex>
    </text>

    <rating name="md_rating">
      <pos>0.060 0.800</pos>
      <size>0.120 0.030</size>
      <color>35C2FFFF</color>
      <unfilledColor>2D4258FF</unfilledColor>
      <unfilledPath>:/star_filled.svg</unfilledPath>
      <zIndex>30</zIndex>
    </rating>

    <image name="md_hidden">
      <path>./art/hidden.svg</path>
      <pos>0.448 0.807</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.022 0.028</maxSize>
      <color>7890A8FF</color>
      <zIndex>30</zIndex>
    </image>

    <image name="md_kidgame">
      <path>./art/kid.svg</path>
      <pos>0.418 0.807</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.022 0.028</maxSize>
      <color>7890A8FF</color>
      <zIndex>30</zIndex>
    </image>

    <image name="md_manual">
      <path>./art/manual.svg</path>
      <pos>0.388 0.807</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.022 0.028</maxSize>
      <color>7890A8FF</color>
      <zIndex>30</zIndex>
    </image>

  </view>


  <!-- ======================= MENU ======================= -->
  <view name="menu">
    <menuText name="menutitle">
      <fontPath>./art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.030</fontSize>
      <color>F4F8FFFF</color>
    </menuText>

    <menuText name="menufooter">
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.019</fontSize>
      <color>60758BFF</color>
    </menuText>

    <menuText name="menutext">
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.026</fontSize>
      <color>A8B6C8FF</color>
      <separatorColor>FFFFFF0D</separatorColor>
      <selectorColor>35C2FFA0</selectorColor>
      <selectorColorEnd>6B7CFFA0</selectorColorEnd>
      <selectedColor>FFFFFFFF</selectedColor>
      <selectorGradientType>horizontal</selectorGradientType>
