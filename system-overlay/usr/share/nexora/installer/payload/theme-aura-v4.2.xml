    <menuTextSmall name="menutextsmall">
      <fontPath>./art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.016</fontSize>
      <color>77D9FFFF</color>
    </menuTextSmall>

    <menuGroup name="menugroup">
      <fontPath>./art/fonts/Cabin-Bold.ttf</fontPath>
      <fontSize>0.018</fontSize>
      <color>77D9FFFF</color>
      <backgroundColor>00000000</backgroundColor>
      <lineSpacing>2.2</lineSpacing>
    </menuGroup>

    <menuBackground name="menubg">
      <color>07101CF7</color>
      <cornerSize>24 24</cornerSize>
      <scrollbarColor>35C2FF40</scrollbarColor>
      <scrollbarSize>0.003</scrollbarSize>
      <scrollbarAlignment>innerright</scrollbarAlignment>
    </menuBackground>
  </view>


  <!-- ======================= SCREEN ======================= -->
  <view name="screen">
    <text name="clock">
      <color>7890A8FF</color>
      <fontSize>0.026</fontSize>
      <pos>0.875 0.953</pos>
      <size>0.105 0.034</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
    </text>

    <controllerActivity name="controllerActivity">
      <pos>0.012 0.012</pos>
      <size>0.17 0.022</size>
      <itemSpacing>0.003</itemSpacing>
      <color>7890A8FF</color>
      <imagePath>./art/gamepad.svg</imagePath>
      <gunPath>./art/gun.svg</gunPath>
      <wheelPath>./art/wheel.svg</wheelPath>
      <activityColor>35C2FFFF</activityColor>
      <hotkeyColor>6B7CFFFF</hotkeyColor>
    </controllerActivity>
  </view>

</theme>
