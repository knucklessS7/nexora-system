managed=aura-flatpak-v6.4
name=Google Chrome
type=command
appid=com.google.Chrome
exec=flatpak run --system com.google.Chrome --no-sandbox --test-type --disable-features=Translate,TranslateUI --lang=pt-BR --no-first-run --no-default-browser-check --disable-session-crashed-bubble --hide-crash-restore-bubble --noerrdialogs --disable-infobars
